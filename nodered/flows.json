    {
        "id": "c086fcba17587385",
        "type": "function",
        "z": "54da57a1d2760d74",
        "name": "Log MQTT Test Alert",
        "func": "\nif (msg.topic !== \"iot/factory/motor01/alerts/test\") {\n    return null;\n}\n\nlet alert = msg.payload;\n\nif (typeof alert === \"string\") {\n    try {\n        alert = JSON.parse(alert);\n    } catch (error) {\n        return null;\n    }\n}\n\nif (!alert || alert.test !== true) {\n    return null;\n}\n\nmsg.payload = JSON.stringify({\n    received_at: new Date().toISOString(),\n    test_only: true,\n    device_id: alert.device_id,\n    severity: alert.severity,\n    fault: alert.fault,\n    actuate_hardware: false\n}) + \"\\n\";\n\nreturn msg;\n",
