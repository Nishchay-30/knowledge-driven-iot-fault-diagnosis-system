    {
        "id": "5b6d533c85cf0f3f",
        "type": "function",
        "z": "54da57a1d2760d74",
        "name": "Save Fault Alert",
        "func": "\nif (msg.topic !== \"iot/factory/motor01/alerts\") {\n    return null;\n}\n\nlet alert = msg.payload;\n\nif (typeof alert === \"string\") {\n    try {\n        alert = JSON.parse(alert);\n    } catch (error) {\n        node.warn(\"Invalid alert JSON\");\n        return null;\n    }\n}\n\nif (!alert || typeof alert !== \"object\" || alert.test === true) {\n    return null;\n}\n\nconst log = {\n    received_at: new Date().toISOString(),\n    timestamp: alert.timestamp,\n    device_id: alert.device_id,\n    severity: alert.severity,\n    fault: alert.fault,\n    message: alert.message,\n    recommended_action: alert.recommended_action\n};\n\nmsg.payload = JSON.stringify(log) + \"\\n\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
