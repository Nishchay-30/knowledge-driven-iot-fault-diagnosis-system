# ==============================================================================
# Knowledge-Driven IoT-Based Fault Diagnosis System — Environment Configuration
# ==============================================================================

# Application Environment (development / production / testing)
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production

# System Operation Mode (simulation / hardware)
OPERATION_MODE=simulation
DEVICE_ID=motor01

# MQTT Broker Configuration
# When USE_LOCAL_BROKER=true or HiveMQ credentials are blank, system falls back to local broker
USE_LOCAL_BROKER=true
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883

# HiveMQ Cloud Credentials (Layer 2 & Cloud Operations)
# TLS port 8883 is standard for HiveMQ Cloud
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
HIVEMQ_USE_TLS=true

# SQLite Database
DATABASE_PATH=data/sqlite/fault_diagnosis.db

# Ingestion & Ingestion Path (mqtt / nodered)
INGESTION_PATH=mqtt
CSV_LOG_PATH=data/csv/sensor_telemetry.csv

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Dashboard
DASHBOARD_PORT=8501

# Node-RED Automation Integration
NODERED_ENABLED=true
NODERED_HOST=127.0.0.1
NODERED_PORT=1880
NODERED_API_URL=http://127.0.0.1:1880

# Machine Learning Paths
ML_MODEL_PATH=ml/models/random_forest_model.joblib
ML_METRICS_PATH=ml/models/model_metrics.json
ML_CONFUSION_MATRIX_PATH=ml/models/confusion_matrix.json

